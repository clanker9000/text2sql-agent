# Copy to .env and fill in. Any OpenAI-compatible API works; pick ONE block.

# OpenAI (what we use)
LLM_MODEL=gpt-6-luna
LLM_API_KEY=sk-...
LLM_BASE_URL=

# Google Gemini (OpenAI-compatible endpoint)
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter (many models, one key)
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Local model via ollama
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# gpt-6-luna rejects temperature=0, so leave this empty (= the model's default)
LLM_TEMPERATURE=

# Folder that contains california_schools/, card_games/, ... (from minidev.zip)
DB_ROOT=/path/to/MINIDEV/dev_databases
